<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="350.0" prefWidth="300.0" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.registropaciente.contollers.UserController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Unicamente el Logo -->
    <ImageView fx:id="imgLogo" fitHeight="90.0" fitWidth="200.0" preserveRatio="true" />

    <TextField fx:id="txtUsuario" promptText="Usuario" />
    <PasswordField fx:id="txtContrasena" promptText="Contraseña" />

    <Button text="Iniciar Sesión" onAction="#loginOnClick" />
</VBox>
