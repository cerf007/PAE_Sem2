<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox alignment="CENTER" spacing="15.0" prefWidth="320.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.registropaciente.UserController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="Iniciar Sesión" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <Label text="Usuario:"/>
    <TextField fx:id="txtUser" promptText="Usuario" />

    <Label text="Contraseña:"/>
    <PasswordField fx:id="txtPassword" promptText="Contraseña" />

    <Button text="Ingresar" onAction="#handleLogin" maxWidth="Infinity" />
    <Label fx:id="lblError" textFill="RED" />
</VBox>
